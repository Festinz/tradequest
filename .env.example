# =====================================
# TradeQuest .env.example
# 실제 값은 .env.local 에 채우세요 (gitignore 됨)
# =====================================

# --- Supabase ---
# https://supabase.com/dashboard 에서 프로젝트 생성 후 Settings → API → Legacy keys 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # 시드 스크립트 전용, 절대 클라이언트에 노출 X

# --- Anthropic Claude API ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- 한국투자증권 KIS Developers (선택) ---
# 본인 계좌 시세를 사용할 때만. 설정 페이지에서 "KIS 개인 모드" 토글 ON 해야 동작.
# 발급: https://apiportal.koreainvestment.com
# 약관: 본인 계좌만 사용 가능, 재배포 금지
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01
KIS_ENV=paper                                            # 'paper' (모의투자) 또는 'real' (실전)
# 모의투자: https://openapivts.koreainvestment.com:29443
# 실전:    https://openapi.koreainvestment.com:9443
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
